# pip's `-e git+https://github.com/noshore5/moabb.git#egg=moabb` (see
# requirements.txt) clones into ./src/moabb by default (pip's `-e git+URL`
# convention, relative to wherever `pip install -r requirements.txt` was
# run) -- that's a separate, already-tracked GitHub repo (noshore5/moabb),
# not content of this repo. Needed on disk for the editable install to
# keep working; must not be committed here (no .gitmodules, so committing
# it would only leave a broken/dangling submodule reference).
/src/

# Python bytecode / caches
__pycache__/
*.py[cod]
*$py.class

# OS cruft
.DS_Store

# Scratch / working files not meant to be tracked
_to_delete/

# Common Python packaging/venv artifacts
*.egg-info/
.eggs/
.ipynb_checkpoints/
.pytest_cache/
